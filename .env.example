# Google Maps Platform key (Maps JS API + Street View).
# Client uses a key restricted by HTTP referrer; server uses a key restricted by IP.
# v1 needs only one key for local dev.
MAPS_API_KEY=your_key_here
# Client reads the same key via Vite (VITE_ prefix required).
VITE_MAPS_API_KEY=your_key_here

# Ports (defaults work for `npm run dev`)
PORT=3001
CLIENT_PORT=3000
